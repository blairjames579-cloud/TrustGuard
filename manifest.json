{
  "manifest_version": 3,
  "name": "TrustGuard Filter",
  "version": "2.1",
  "description": "Live Threat Blocker",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}